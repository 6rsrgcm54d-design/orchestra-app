# Google OAuth 2.0 Client ID
# Obtido em: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google API Key (para inicializar a Sheets API)
# Obtido em: Google Cloud Console > APIs & Services > Credentials > API Key
VITE_GOOGLE_API_KEY=your-google-api-key
